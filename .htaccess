RewriteEngine On

# Combined redirect: Force HTTPS and non-www in ONE redirect
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.arunpanthi\.com\.np$ [NC]
RewriteRule ^ https://arunpanthi.com.np%{REQUEST_URI} [R=301,L]

# Add trailing slash for real directories only (avoid redirecting files)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)$ $1/ [R=301,L]

# Redirect index.html and index.php to clean URL (only on direct request)
RewriteCond %{THE_REQUEST} \s/+(([^/]+/)*)index\.(html|php)[?\s] [NC]
RewriteRule ^ %1 [R=301,L]

# Remove .html extension from URLs (for specific pages)
RewriteCond %{THE_REQUEST} \s/+PrivacyPolicy\.html [NC]
RewriteRule ^PrivacyPolicy\.html$ /PrivacyPolicy [R=301,L]

RewriteCond %{THE_REQUEST} \s/+TermsofService\.html [NC]
RewriteRule ^TermsofService\.html$ /TermsofService [R=301,L]

RewriteCond %{THE_REQUEST} \s/+aboutus\.html [NC]
RewriteRule ^aboutus\.html$ /aboutus [R=301,L]

# ---------------------------------------------------------------------------
# Legacy / duplicate URL consolidation (301).
#
# These routes were copies of, or thin placeholders for, pages that already
# live elsewhere. Google reported them as "Excluded by 'noindex' tag",
# "Duplicate" and "Soft 404". The block below is generated from
# tools/redirects.py so .htaccess, 404.html and the sitemap cannot drift apart.
# ---------------------------------------------------------------------------
# BEGIN legacy-redirects (generated by tools/generate-redirects.py)
# Same map as js/legacy-redirects.js, for Apache hosts. Regenerate with
# python3 tools/generate-redirects.py

# Duplicates of pages that already have a canonical URL.
RewriteRule ^Home\.html$ / [R=301,L,NC]
RewriteRule ^Home/?$ / [R=301,L,NC]
RewriteRule ^Home/Notes/?$ /NEC-license-preparation/Notes [R=301,L,NC]
RewriteRule ^Home/Solutions/?$ /Resources/Solutions [R=301,L,NC]
RewriteRule ^Home/past-questions/?$ /Resources/Past-Questions [R=301,L,NC]
RewriteRule ^Resources/Past-Questions/Past-Questions(/.*)?$ /Resources/Past-Questions [R=301,L,NC]
RewriteRule ^NEC-license-preparation/Notes/NEC-license-preparation(/.*)?$ /NEC-license-preparation/Notes/ [R=301,L,NC]

# Notes that were published as an extension-less .html file.
RewriteRule ^NEC-license-preparation/Notes/Engineering-Drawing(\.html)?/?$ /NEC-license-preparation/Notes/Engineering-Drawing/ [R=301,L,NC]
RewriteRule ^NEC-license-preparation/Notes/Construction-Materials(\.html)?/?$ /NEC-license-preparation/Notes/Construction-Materials/ [R=301,L,NC]

# Thin placeholder pages, consolidated onto the page that covers the topic.
RewriteRule ^Resources/Past-Questions/(Airport-Engineering|Building-Construction|Concrete-Technology|Construction-Management|Construction-Materials|Engineering-Drawing|Engineering-Economics|Engineering-Geology|Engineering-Hydrology|Estimation-Valuation|Fluid-Mechanics|Foundation-Engineering|Hydraulics|Hydropower-Engineering|Irrigation-Engineering|Professional-Practices|Project-Management|RCC-Design|Sanitation-Engineering|Soil-Mechanics|Steel-Timber-Design|Strength-of-Materials|Surveying|Theory-of-Structures|Transportation-Engineering|Water-Supply)/?$ /Resources/Past-Questions/ [R=301,L,NC]
RewriteRule ^NEC-license-preparation/Notes/(Airport-Engineering|Building-Construction-and-Drawings|Concrete-Technology-and-Masonry-Structures|Construction-Management|Design-of-RCC-Structures|Design-of-Steel-and-Timber-Structures|Engineering-Economics|Engineering-Geology|Engineering-Hydrology|Engineering-Professional-Practices|Estimation-and-Valuation|Fluid-Mechanics|Foundation-Engineering|Hydraulics|Hydropower-Engineering|Irrigation-Engineering|Project-Management|Sanitation-Engineering|Soil-Mechanics|Strength-of-Materials|Surveying|Theory-of-Structures|Transportation-Engineering|Water-Supply-Engineering)/?$ /NEC-license-preparation/Notes/ [R=301,L,NC]
RewriteRule ^Psc-preparation/Syllabus/(ministry-physical-infrastructure-syllabus|nea-syllabus|nepal-oil-corporation-syllabus|road-department-syllabus)/?$ /Psc-preparation/Syllabus/ [R=301,L,NC]
RewriteRule ^Psc-preparation/Syllabus/nepal-telecom-syllabus/?$ /Psc-preparation/Syllabus/Nepal-telecom [R=301,L,NC]
RewriteRule ^NEC-license-preparation/MCQ/?$ /NEC-license-preparation/Test/ [R=301,L,NC]
RewriteRule ^NEC-license-preparation/exam-preparation/?$ /NEC-license-preparation/ [R=301,L,NC]
RewriteRule ^Psc-preparation/Psc-video/?$ /Psc-video/ [R=301,L,NC]
# END legacy-redirects

# On Apache, also serve dated exams that don't have a generated static page yet.
# Published exam folders are used directly by static hosts such as GitHub Pages.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^Psc-preparation/Current-Affairs/exam/date=[0-9]{4}-[0-9]{2}-[0-9]{2}/?$ /Psc-preparation/Current-Affairs/exam.html [L]

# Serve .html files when extension-less URL is requested (internal rewrite, no redirect)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Browser caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    ExpiresByType text/css "access plus 6 months"
    ExpiresByType application/javascript "access plus 6 months"
    ExpiresByType text/javascript "access plus 6 months"

    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"

    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# Cache-Control + security headers
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|ico|svg|webp|css|js|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>

    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Disable directory listing
Options -Indexes

# Protect sensitive files
<FilesMatch "^(\.htaccess|\.htpasswd|config\.php|wp-config\.php|error_log)$">
    Require all denied
</FilesMatch>

# Block hidden files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Error pages
ErrorDocument 400 /404.html
ErrorDocument 401 /404.html
ErrorDocument 403 /404.html
ErrorDocument 404 /404.html
ErrorDocument 500 /404.html

# MIME types
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType font/woff .woff
    AddType font/woff2 .woff2
    AddType image/x-icon .ico
    AddType application/manifest+json .webmanifest
</IfModule>
