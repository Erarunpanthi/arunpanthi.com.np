# ---------------------------------------------------------------------------
# admin-server configuration — copy to `.env` (never commit the real file)
# ---------------------------------------------------------------------------

# --- GitHub ---------------------------------------------------------------
# Fine-grained token, this repository only, permissions:
#   Contents: Read and write
#   Metadata: Read-only (automatic)
#   Pull requests: Read and write   (only needed for the PR publish mode)
#   Pages: Read-only                (optional, shows deployment status)
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=Erarunpanthi
GITHUB_REPO=arunpanthi.com.np
GITHUB_BRANCH=main

# --- Admin login ----------------------------------------------------------
# Option A (recommended): a pbkdf2 hash. Generate it with:
#   npm --prefix admin-server run hash-password
# Option B: ADMIN_PASSWORD=your-strong-password  (hashed in memory at boot)
ADMIN_PASSWORD_HASH=pbkdf2$sha256$210000$...

# At least 16 random characters. Rotate it to sign everyone out.
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=12

# --- Server ---------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
# Serve the website from this folder too (nice for local preview).
SERVE_SITE=1
# Leave blank to use the repository root (the parent of admin-server/).
# SITE_ROOT=

# Browser origins allowed to call the API (comma separated, * = any).
# GitHub Pages frontend must be listed when the API is on another host.
ALLOWED_ORIGINS=https://arunpanthi.com.np,https://www.arunpanthi.com.np,http://localhost:8787

# --- Safety ---------------------------------------------------------------
# direct = commit to GITHUB_BRANCH, pr = open a pull request
PUBLISH_MODE=direct
# 1 = validate everything but never create a real commit
DRY_RUN=0
# 1 = block all writes (preview/demo mode)
READ_ONLY=0
MAX_UPLOAD_MB=25
# Set to 1 when running behind Render/Railway/nginx so the client IP is read
# from X-Forwarded-For (used for login rate limiting).
TRUST_PROXY=0

# Public site URL used for "copy link" and upload URLs.
PUBLIC_SITE_URL=https://arunpanthi.com.np
